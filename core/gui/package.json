{
  "name": "tigo-sec-toolkit-gui",
  "version": "1.5.0",
  "description": "TigoSecToolkit — Interface Gráfica",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && vite build",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.tigosec.toolkit",
    "productName": "TigoSecToolkit",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TigoSecToolkit"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "../scripts/**/*",
      "../package.json",
      "!../scripts/tools/**/*",
      "!../scripts/venv/**/*"
    ],
    "extraResources": [
      {
        "from": "../scripts/setup.js",
        "to": "setup.js"
      }
    ]
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.470.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "artillery": "^2.0.31",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "depcheck": "^1.4.7",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lighthouse": "^13.3.0",
    "madge": "^8.0.0",
    "postcss": "^8.4.0",
    "snyk": "^1.1304.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
